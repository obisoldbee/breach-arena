{
  "name": "breach-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer destructible arena shooter with proximity voice and HTTPS fallback",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "node tests/engine.test.mjs && node tests/test-network.mjs && node tests/entry.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
